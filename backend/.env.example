# Copy to .env and fill in real values. Never commit real credentials.
GMAIL_ADDRESS=your-address@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Authentication (alternative to backend/data/auth.json)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generated-password-hash
AUTH_SECRET=generated-random-secret
AUTH_TOKEN_TTL_SECONDS=28800
